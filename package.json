{
  "name": "auto-job-apply-playwright",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "test": "playwright test",
    "test:all": "playwright test tests/JobApplication.spec.ts",
    "test:linkedin": "playwright test tests/LinkedinTest.spec.ts",
    "test:naukri": "playwright test tests/NaukriTest.spec.ts",
    "test:parallel": "playwright test tests/JobApplication.spec.ts --workers=4",
    "test:parallel:max": "playwright test tests/JobApplication.spec.ts --workers=8",
    "test:headed": "playwright test --headed --workers=1",
    "test:headed:all": "playwright test tests/JobApplication.spec.ts --headed --workers=2",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report"
  },
  "keywords": [
    "automation",
    "job-application",
    "linkedin",
    "naukri",
    "playwright"
  ],
  "author": "",
  "license": "ISC",
  "description": "Automated job application system for LinkedIn and Naukri using Playwright",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3",
    "allure-playwright": "^2.15.1",
    "allure-commandline": "^2.24.0"
  }
}
